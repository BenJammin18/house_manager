HOUSE_MANAGER_DATABASE_URL=sqlite:///./house_manager.db
HOUSE_MANAGER_TIMEZONE=America/New_York

HOUSE_MANAGER_ANTHROPIC_API_KEY=

# Twilio: either ACCOUNT_SID + AUTH_TOKEN, or ACCOUNT_SID + API_KEY_SID/SECRET.
HOUSE_MANAGER_TWILIO_ACCOUNT_SID=
HOUSE_MANAGER_TWILIO_AUTH_TOKEN=
HOUSE_MANAGER_TWILIO_API_KEY_SID=
HOUSE_MANAGER_TWILIO_API_KEY_SECRET=
HOUSE_MANAGER_TWILIO_FROM_NUMBER=

HOUSE_MANAGER_GOOGLE_CLIENT_ID=
HOUSE_MANAGER_GOOGLE_CLIENT_SECRET=
HOUSE_MANAGER_GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HOUSE_MANAGER_ENCRYPTION_KEY=

# Plaid: sandbox is free for testing; development/production for real accounts.
HOUSE_MANAGER_PLAID_CLIENT_ID=
HOUSE_MANAGER_PLAID_SECRET=
HOUSE_MANAGER_PLAID_ENV=sandbox
